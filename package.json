{
  "name": "keep-my-number",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.js",
    "postinstall": "node scripts/init-audio.mjs",
    "deploy": "node scripts/check-config.mjs && wrangler deploy --config wrangler.json",
    "build": "wrangler deploy --dry-run --config wrangler.example.json --outdir dist",
    "audio": "python3 scripts/generate-audio.py",
    "twilio:plan": "python3 scripts/deploy-twilio.py --dry-run",
    "twilio:deploy": "node scripts/check-config.mjs && python3 scripts/deploy-twilio.py --apply"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "miniflare": "4.20260730.0",
    "wrangler": "4.131.0"
  },
  "dependencies": {
    "libphonenumber-js": "1.13.13"
  },
  "overrides": {
    "undici": "7.29.0",
    "sharp": "0.35.4"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  }
}
