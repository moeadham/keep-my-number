{
  "name": "phone-forwarder",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-10",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSIONS",
        "class_name": "ForwardingSession"
      },
      {
        "name": "SPEECH",
        "class_name": "SpeechCache"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ForwardingSession"
      ]
    },
    {
      "tag": "v2-whole-speech",
      "new_sqlite_classes": [
        "SpeechCache"
      ]
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": [
        "sms@example.com"
      ],
      "allowed_destination_addresses": [
        "inbox@example.com"
      ]
    }
  ],
  "vars": {
    "ALLOWED_NUMBERS": "[\"+12025550100\"]",
    "OUTBOUND_FROM": "+12025550100",
    "FORWARD_TO": "+12025550101",
    "TWILIO_ACCOUNT_SID": "AC00000000000000000000000000000000",
    "PUBLIC_ORIGIN": "https://forwarder.example.com",
    "EMAIL_FROM": "sms@example.com",
    "EMAIL_TO": "inbox@example.com",
    "TTS_MODEL": "fish/s2-1-pro",
    "TTS_VOICE": ""
  },
  "observability": {
    "enabled": false
  }
}
